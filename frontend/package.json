{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:prod": "run-s fetch-version-hash type-check build-only:prod",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:prod": "vite build --mode prod",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "fetch-version-hash": "node fetchVersion.cjs",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "autocompleter": "^10.0.0",
    "axios": "^1.21.0",
    "marked": "^18.1.3",
    "vue": "^3.5.45",
    "vue-draggable-next": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  }
}

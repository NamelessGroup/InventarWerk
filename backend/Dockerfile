# syntax=docker/dockerfile:1
#
# One Dockerfile, one image per service. Select the service with --target:
#   docker build -f backend/Dockerfile --target inventarwerk_api  .
#   docker build -f backend/Dockerfile --target zauberwerk_api    .
#   docker build -f backend/Dockerfile --target last_changes_api  .
# or build everything at once with `docker buildx bake` (see docker-bake.hcl).
#
# The build context is the repository root.
# The build runs in SQLx offline mode and needs backend/.sqlx, generated by
#   cargo sqlx prepare --workspace
# against a database with all migrations applied (CI does this automatically).

# ---------- build ----------
FROM rust:1-trixie AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY backend/ .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
# Build dependencies only; this layer stays cached until Cargo.toml/Cargo.lock change
COPY --from=planner /app/recipe.json .
RUN cargo chef cook --release --recipe-path recipe.json
COPY backend/ .
RUN test -d .sqlx || (echo "backend/.sqlx is missing. Run 'cargo sqlx prepare --workspace' in backend/ first." && exit 1)
ENV SQLX_OFFLINE=true
RUN cargo build --release --workspace --bins

# ---------- shared runtime base ----------
FROM debian:trixie-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 app
WORKDIR /app
# Rocket listens on 127.0.0.1 by default, which is unreachable from outside the container
ENV ROCKET_ADDRESS=0.0.0.0 \
    ROCKET_PORT=8000
EXPOSE 8000

# ---------- inventarwerk_api ----------
FROM runtime AS inventarwerk_api
# pg_dump for the backup endpoint, one per supported PostgreSQL major version.
# The endpoint picks the one matching the server at runtime (/usr/lib/postgresql/<major>/bin):
# an older pg_dump cannot dump a newer server, and a dump made by a newer pg_dump
# may not restore into an older server.
ARG PG_VERSIONS="15 16 17 18"
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-common \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends $(for v in ${PG_VERSIONS}; do echo "postgresql-client-$v"; done) \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/inventarwerk_api ./
USER app
CMD ["./inventarwerk_api"]

# ---------- zauberwerk_api ----------
FROM runtime AS zauberwerk_api
COPY --from=builder /app/target/release/zauberwerk_api ./
USER app
CMD ["./zauberwerk_api"]

# ---------- last_changes_api ----------
FROM runtime AS last_changes_api
COPY --from=builder /app/target/release/last_changes_api ./
USER app
CMD ["./last_changes_api"]
